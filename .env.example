# Copiez ce fichier en ".env" avant de démarrer le serveur

# Port du serveur
PORT=3000

# Secret utilisé pour signer les tokens JWT — CHANGEZ CETTE VALEUR en production
JWT_SECRET=change-this-secret-in-production-please

# Durée de validité du token (format "vercel/ms", ex: 12h, 7d)
JWT_EXPIRES_IN=12h
